{
  "name": "@trace-kit/browser",
  "version": "0.0.0",
  "private": true,
  "description": "Browser integrations and transports for TraceKit.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm clean && pnpm build:js && pnpm build:types",
    "build:js": "tsup --config tsup.config.ts",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --environment jsdom",
    "test:watch": "vitest --environment jsdom",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@trace-kit/core": "workspace:*",
    "web-vitals": "^6.2.3"
  }
}
